# Ignore dot-prefixed local files/directories at every level.
.*
!.gitignore
!.gitmodules

# Ignore Python cache directories everywhere.
__pycache__/

# Ignore build and csi.egg-info folders in csi_cutde_mpiparallel
csi_cutde_mpiparallel/build/
csi_cutde_mpiparallel/csi.egg-info/
csi_cutde_mpiparallel/csi/__pycache__/

# Ignore build and eqtools.egg-info folders in eqtools
eqtools/build/
eqtools/eqtools.egg-info/

# Generated distribution artifacts.
build/
dist/
*.egg-info/
*.py[cod]
